<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      읽기·안내용 권한만 선언한다. CONTROL_* (차량 제어)는 선언하지 않는다(제동·조향 등 차량 제어 금지).
      실제 필요 권한은 Pleos_Connect_v2.1.0 에뮬레이터의 SecurityException 메시지로 확인 (SDK_COMPATIBILITY.md).
    -->
    <!-- 쓰는 API 의 권한만 선언한다: 승인 범위 밖 권한 선언은 Pleos 앱 심사 탈락 사유 (document.pleos.ai Overview).
         Gear API 는 공식 도메인 표에 없다. 에뮬레이터에서는 CAR_DRIVE 로 동작 확인, 심사 전 승인 확인 필요. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- protectionLevel=dangerous → 런타임 동의 필요 (MainActivity 에서 요청) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
</manifest>
