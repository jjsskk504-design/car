{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/schema/prediction-frame-1.0.json",
  "title": "PRISM PredictionFrame 1.0 (Part 01 local validation copy)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp_ms", "predictions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vehicle_id", "trajectories"],
        "properties": {
          "vehicle_id": {"type": "string", "minLength": 1},
          "trajectories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "confidence", "points"],
              "properties": {
                "mode": {"type": "string", "minLength": 1},
                "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dt_ms", "x", "y", "heading_rad"],
                    "properties": {
                      "dt_ms": {"type": "integer", "exclusiveMinimum": 0},
                      "x": {"type": "number"},
                      "y": {"type": "number"},
                      "heading_rad": {"type": "number"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
